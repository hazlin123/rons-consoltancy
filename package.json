{
  "name": "rons-future-bridge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Monorepo for Rons Future Bridge Consultancy - Website and Admin Portal",
  "scripts": {
    "dev:website": "pnpm --filter website dev",
    "dev:portal": "pnpm --filter portal dev",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build:website": "pnpm --filter website build",
    "build:portal": "pnpm --filter portal build",
    "build": "pnpm --parallel --filter './apps/*' build",
    "preview:website": "pnpm --filter website preview",
    "preview:portal": "pnpm --filter portal preview"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  }
}